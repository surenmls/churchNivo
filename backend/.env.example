PORT=1990
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/church_platform

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=7d

# URLs (comma-separated for multiple origins in production)
FRONTEND_URL=http://localhost:1989
API_PUBLIC_URL=http://localhost:1990

# Domain resolution (optional)
# BASE_DOMAIN=churchplatform.com

# Email (Gmail SMTP) — required for contact form & Stay Connected emails
# 1. Enable 2-Step Verification on your Google account
# 2. Create an App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character app password as SMTP_PASS (not your Gmail login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="ChurchNivo <your-email@gmail.com>"
PLATFORM_CONTACT_EMAIL=your-email@gmail.com

# Uploads
UPLOAD_MAX_MB=5
UPLOAD_DIR=uploads

# Supabase Storage (images are saved as /media/<path> and served from this bucket)
# Bucket must be public. Service role key is server-only — never expose it to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=church-media
# Optional: public base URL for media in API responses (defaults to the Supabase bucket URL).
# Set this if you move files to another host or CDN, e.g. https://media.yourdomain.com
# MEDIA_PUBLIC_URL=

# Default storage plans (per church, configurable by super admin)
# free: 50 photos / 100 MB | starter: 200 photos / 500 MB | pro: 1000 photos / 5 GB

# Web Push (generate with: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@churchplatform.com

# SMS via Twilio (optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
